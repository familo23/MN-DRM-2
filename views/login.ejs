<%- include('layouts/header', { title: 'Đăng nhập - Mầm Non Đồ Rê Mí 2' }) %>

<main class="login-decor-section position-relative py-5 my-2">
    <!-- Họa tiết mầm non bay bổng nền trang đăng nhập -->
    <div class="login-bg-decor" aria-hidden="true">
        <div class="login-cloud cloud-1">
            <svg viewBox="0 0 120 60" width="130"><path d="M15,45 Q5,45 5,35 Q5,20 20,20 Q28,10 45,15 Q60,5 80,18 Q95,12 105,25 Q118,30 115,45 Z" fill="rgba(255,255,255,0.85)"/></svg>
        </div>
        <div class="login-cloud cloud-2">
            <svg viewBox="0 0 120 60" width="150"><path d="M15,45 Q5,45 5,35 Q5,20 20,20 Q28,10 45,15 Q60,5 80,18 Q95,12 105,25 Q118,30 115,45 Z" fill="rgba(255,255,255,0.75)"/></svg>
        </div>
        <div class="login-star star-1"><i class="bi bi-star-fill text-warning"></i></div>
        <div class="login-star star-2"><i class="bi bi-stars text-warning"></i></div>
        <div class="login-bubble bubble-a"></div>
        <div class="login-bubble bubble-b"></div>
        <div class="login-heart heart-1"><i class="bi bi-heart-fill text-danger opacity-50"></i></div>

        <!-- Cầu vồng mầm non pastel -->
        <div class="login-decor-rainbow">
            <svg viewBox="0 0 120 60" width="110">
                <path d="M10,60 A50,50 0 0,1 110,60" fill="none" stroke="#fca5a5" stroke-width="7"/>
                <path d="M17,60 A43,43 0 0,1 103,60" fill="none" stroke="#fed7aa" stroke-width="7"/>
                <path d="M24,60 A36,36 0 0,1 96,60" fill="none" stroke="#fef08a" stroke-width="7"/>
                <path d="M31,60 A29,29 0 0,1 89,60" fill="none" stroke="#bbf7d0" stroke-width="7"/>
                <path d="M38,60 A22,22 0 0,1 82,60" fill="none" stroke="#bae6fd" stroke-width="7"/>
            </svg>
        </div>

        <!-- Chong chóng xoay nhiều màu -->
        <div class="login-decor-pinwheel" title="Chong chóng tuổi thơ">
            <svg viewBox="0 0 60 60" width="55" height="55" class="pinwheel-svg">
                <g class="pinwheel-blades">
                    <path d="M30,30 Q30,10 40,10 Q40,30 30,30 Z" fill="#ef4444"/>
                    <path d="M30,30 Q50,30 50,40 Q30,40 30,30 Z" fill="#3b82f6"/>
                    <path d="M30,30 Q30,50 20,50 Q20,30 30,30 Z" fill="#eab308"/>
                    <path d="M30,30 Q10,30 10,20 Q30,20 30,30 Z" fill="#10b981"/>
                </g>
                <circle cx="30" cy="30" r="4" fill="#ffffff" stroke="#f59e0b" stroke-width="2"/>
            </svg>
            <div class="pinwheel-stick"></div>
        </div>
    </div>

    <div class="container position-relative z-2">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card login-card border-0 shadow-lg rounded-4 overflow-hidden <%= typeof error !== 'undefined' ? 'shake-card' : '' %>" id="loginCard">
                    
                    <!-- Header Card mầm non -->
                    <div class="card-header login-header text-white text-center pt-4 pb-3 border-0">
                        <div class="login-logo-badge mb-2">
                            <img src="/images/logo.png" alt="Logo Mầm Non Đồ Rê Mí" width="60" height="60" class="rounded-circle shadow-sm">
                        </div>
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold mb-1 shadow-sm">
                            <i class="bi bi-stars me-1"></i>ĐỒ RÊ MÍ 2
                        </span>
                        <h3 class="fw-bold mb-0 text-white" id="authHeaderTitle">Cổng Thông Tin Quản Trị</h3>
                        <p class="mb-0 mt-1 text-white-50 small" id="authHeaderSubtitle">Dành cho Giáo viên & Quản trị viên</p>
                    </div>

                    <div class="card-body p-4 p-sm-5 bg-white position-relative">

                        <!-- Thông báo lỗi từ server EJS -->
                        <% if (typeof error !== 'undefined' && error == '1') { %>
                            <div class="alert alert-danger rounded-4 text-center small fw-bold shadow-sm mb-4 alert-bounce" id="serverErrorAlert">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Tài khoản hoặc mật khẩu không chính xác!
                            </div>
                        <% } %>
                        <% if (typeof error !== 'undefined' && error == '2') { %>
                            <div class="alert alert-warning rounded-4 text-center small fw-bold shadow-sm mb-4 alert-bounce" id="serverErrorAlert">
                                <i class="bi bi-shield-lock-fill me-1"></i> Bạn cần đăng nhập để truy cập trang quản trị!
                            </div>
                        <% } %>

                        <!-- Thông báo lỗi động qua AJAX JS -->
                        <div class="alert alert-danger rounded-4 text-center small fw-bold shadow-sm mb-4 d-none alert-bounce" id="clientErrorAlert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> <span id="clientErrorMessage">Tài khoản hoặc mật khẩu không chính xác!</span>
                        </div>

                        <!-- Khung thông báo thành công xanh rực rỡ -->
                        <div class="login-success-overlay d-none" id="loginSuccessBox">
                            <div class="success-icon-wrap">
                                <i class="bi bi-check2-circle text-success"></i>
                            </div>
                            <h4 class="fw-bold text-success mt-3 mb-1" id="successTitle">Đăng nhập thành công!</h4>
                            <p class="text-muted small" id="successSubtitle">Đang chuyển hướng vào hệ thống...</p>
                        </div>

                        <!-- FORM ĐĂNG NHẬP -->
                        <form action="/login" method="POST" id="loginForm">
                            <div class="mb-4 input-group-cute">
                                <label for="username" class="form-label fw-bold text-secondary small text-uppercase">
                                    <i class="bi bi-person-heart me-1 text-primary"></i>Tên đăng nhập
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3">
                                        <i class="bi bi-person text-muted"></i>
                                    </span>
                                    <input type="text" class="form-control border-start-0 ps-1 bg-light rounded-end-pill py-2" id="username" name="username" placeholder="Nhập tên đăng nhập" required autocomplete="username">
                                </div>
                            </div>

                            <div class="mb-4 input-group-cute">
                                <label for="password" class="form-label fw-bold text-secondary small text-uppercase">
                                    <i class="bi bi-shield-lock me-1 text-primary"></i>Mật khẩu
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3">
                                        <i class="bi bi-lock text-muted"></i>
                                    </span>
                                    <input type="password" class="form-control border-start-0 ps-1 bg-light rounded-end-pill py-2" id="password" name="password" placeholder="Nhập mật khẩu" required autocomplete="current-password">
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe">
                                    <label class="form-check-label text-muted small" for="rememberMe">Ghi nhớ phiên</label>
                                </div>
                                <a href="tel:0988906951" class="text-decoration-none small text-primary fw-bold hover-underline" title="Liên hệ quản trị viên">
                                    <i class="bi bi-question-circle me-1"></i>Trợ giúp?
                                </a>
                            </div>

                            <div class="d-grid mt-2">
                                <button type="submit" class="btn btn-cute btn-primary py-2 fw-bold shadow-sm" id="btnLogin">
                                    <span class="btn-text">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                                    </span>
                                    <span class="btn-spinner d-none">
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        Đang kiểm tra...
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer bg-light text-center py-3 border-0 d-flex justify-content-between align-items-center px-4">
                        <a href="/" class="text-muted text-decoration-none small fw-bold">
                            <i class="bi bi-arrow-left me-1"></i>Về trang chủ
                        </a>
                        <span class="small text-muted">
                            <i class="bi bi-balloon-heart text-danger me-1"></i>Yêu thương các bé
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('layouts/footer') %>


