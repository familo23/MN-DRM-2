<%- include('layouts/header', { title: 'Trang Chủ - Mầm Non Đồ Rê Mí' }) %>

<style>
    .wave-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
        z-index: 5;
    }
    .wave-bottom svg {
        display: block;
        width: calc(100% + 1.3px);
        height: 60px;
    }
    .wave-bottom .shape-fill {
        fill: #ffffff;
    }
</style>

<!-- HERO CAROUSEL -->
<section id="home" class="position-relative bg-dark">
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <div class="carousel-indicators z-3">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
        </div>
        <div class="carousel-inner shadow-sm">
            <div class="carousel-item active" data-bs-interval="3000">
                <img src="/images/banner1.jpg" class="d-block w-100" alt="Lớp học">
            </div>
            <div class="carousel-item" data-bs-interval="3000">
                <img src="/images/banner2.jpg" class="d-block w-100" alt="Mỹ thuật">
            </div>
            <div class="carousel-item" data-bs-interval="3000">
                <img src="/images/banner3.jpg" class="d-block w-100" alt="Vui chơi ngoài trời">
            </div>
        </div>
        <button class="carousel-control-prev z-3" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon rounded-circle bg-dark bg-opacity-50 p-3"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next z-3" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon rounded-circle bg-dark bg-opacity-50 p-3"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    
    <!-- Wave Bottom Separator -->
    <div class="wave-bottom">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V0C73.23,24.3,149.33,52.42,223.3,64.22c32.74,5.2,65.8,7.91,98.09,1.2Z" class="shape-fill"></path>
        </svg>
    </div>
</section>

<!-- MAIN CONTENT -->
<main class="container py-5 my-3">
    
    <!-- GIỚI THIỆU -->
    <section id="about" class="mb-5 pb-5 text-center">
        <h2 class="display-5 fw-bold text-primary mb-4">Về Chúng Tôi</h2>
        <p class="fs-5 text-muted mx-auto" style="max-width: 800px;">
            Trường Mầm Non Đồ Rê Mí tự hào là ngôi nhà thứ hai của bé. Chúng tôi mang đến một môi trường giáo dục thân thiện, an toàn và sáng tạo, nơi mỗi đứa trẻ đều được tôn trọng và phát triển toàn diện cả về thể chất lẫn tinh thần.
        </p>
    </section>

    <!-- TIỆN ÍCH -->
    <section id="sign" class="pt-3">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary mb-3">Tiện Ích Khác</h2>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <div class="card h-100 border-0 shadow-sm feature-card rounded-4">
                    <div class="card-body text-center p-5">
                        <div class="icon-circle bg-primary-subtle text-primary mb-4 mx-auto">
                            <i class="bi bi-person-badge fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Thông Tin Của Bé</h4>
                        <p class="text-muted mb-4">Đăng nhập để xem ký hiệu, tình trạng sức khỏe và nhận xét hàng ngày của giáo viên về bé.</p>
                        <a href="/login" class="btn btn-primary rounded-pill px-5 py-2">Đăng Nhập</a>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card h-100 border-0 shadow-sm feature-card rounded-4">
                    <div class="card-body text-center p-5">
                        <div class="icon-circle bg-success-subtle text-success mb-4 mx-auto">
                            <i class="bi bi-journal-text fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Tin Tức Mới</h4>
                        <p class="text-muted mb-4">Cập nhật thực đơn dinh dưỡng, thông báo từ nhà trường và các sự kiện ngoại khóa sắp tới.</p>
                        <a href="#" class="btn btn-outline-success rounded-pill px-5 py-2">Xem Ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('layouts/footer') %>
