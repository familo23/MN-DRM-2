<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Trường Mầm Non Đồ Rê Mí 2' %></title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar site-navbar navbar-expand-lg sticky-top py-2 py-lg-3" id="siteNavbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center text-decoration-none" href="/">
                <img src="/images/logo.png" alt="Logo Mầm Non Đồ Rê Mí" width="48" height="48" class="me-2 rounded-circle brand-logo-img">
                <span class="brand-text">Đồ Rê Mí</span>
                <span class="brand-badge">CS2</span>
            </a>
            <button class="navbar-toggler border-0 shadow-none rounded-pill p-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end mt-3 mt-lg-0" id="navbarNav">
                <ul class="navbar-nav gap-2 align-items-lg-center">
                    <li class="nav-item nav-item-stagger stagger-1">
                        <a class="nav-link px-3 rounded-pill hover-nav <%= typeof currentRoute !== 'undefined' && currentRoute === '/' ? 'active-nav' : '' %>" href="/"><i class="bi bi-house-door-fill me-1"></i>Trang Chủ</a>
                    </li>
                    <li class="nav-item nav-item-stagger stagger-2">
                        <a class="nav-link px-3 rounded-pill hover-nav <%= typeof currentRoute !== 'undefined' && currentRoute === '/tkb' ? 'active-nav' : '' %>" href="/tkb"><i class="bi bi-calendar3 me-1"></i>Thời Khóa Biểu</a>
                    </li>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item nav-item-stagger stagger-3">
                            <a class="nav-link px-3 rounded-pill hover-nav <%= typeof currentRoute !== 'undefined' && currentRoute === '/admin' ? 'active-nav' : '' %>" href="/admin"><i class="bi bi-person-circle me-1"></i><%= user.username %></a>
                        </li>
                    <% } else { %>
                        <li class="nav-item nav-item-stagger stagger-3">
                            <a class="nav-link px-3 rounded-pill hover-nav <%= typeof currentRoute !== 'undefined' && currentRoute === '/login' ? 'active-nav' : '' %>" href="/login"><i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <% if (typeof currentRoute !== 'undefined' && currentRoute === '/') { %>
    <!-- DẢI CHÀO MỪNG: 2 CHÚ SƯ TỬ (LÂN CHIBI) CẦM TỜ SỚ "ĐỒ RÊ MÍ 2" -->
    <div class="lion-welcome-strip" id="lionWelcomeStrip">
        <div class="lion-ceremony-wrap">
            <!-- Chú Lân Trái -->
            <div class="lion-mascot lion-left" id="lionMascotLeft" role="button" tabindex="0" title="Bé chạm vào chú lân để nghe tiếng cổ vũ!">
                <svg class="lion-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <!-- Bờm sư tử / lân nhiều cánh -->
                    <g class="lion-mane">
                        <circle cx="50" cy="50" r="44" fill="#f59e0b"/>
                        <circle cx="20" cy="40" r="14" fill="#ea580c"/>
                        <circle cx="80" cy="40" r="14" fill="#ea580c"/>
                        <circle cx="18" cy="60" r="13" fill="#f97316"/>
                        <circle cx="82" cy="60" r="13" fill="#f97316"/>
                        <circle cx="30" cy="22" r="14" fill="#ea580c"/>
                        <circle cx="70" cy="22" r="14" fill="#ea580c"/>
                        <circle cx="50" cy="16" r="14" fill="#dc2626"/>
                    </g>
                    <!-- Tai sư tử -->
                    <path d="M22,32 Q14,16 32,24 Z" fill="#ef4444"/>
                    <path d="M25,29 Q19,20 30,25 Z" fill="#fecdd3"/>
                    <path d="M78,32 Q86,16 68,24 Z" fill="#ef4444"/>
                    <path d="M75,29 Q81,20 70,25 Z" fill="#fecdd3"/>
                    <!-- Khuôn mặt tròn chibi -->
                    <circle cx="50" cy="52" r="32" fill="#fffbeb" stroke="#f59e0b" stroke-width="2"/>
                    <!-- Sừng / Mũ lân trang trí -->
                    <path d="M50,20 Q56,32 50,38 Q44,32 50,20 Z" fill="#ef4444"/>
                    <circle cx="50" cy="22" r="4" fill="#fde047"/>
                    <!-- Mắt sư tử có hiệu ứng chớp -->
                    <g class="lion-eyes">
                        <ellipse class="lion-eye" cx="38" cy="48" rx="4.5" ry="5.5" fill="#1e293b"/>
                        <circle cx="39.5" cy="46.5" r="1.8" fill="#ffffff"/>
                        <ellipse class="lion-eye" cx="62" cy="48" rx="4.5" ry="5.5" fill="#1e293b"/>
                        <circle cx="63.5" cy="46.5" r="1.8" fill="#ffffff"/>
                    </g>
                    <!-- Má hồng đáng yêu -->
                    <ellipse cx="32" cy="57" rx="5" ry="3" fill="#f43f5e" opacity="0.6"/>
                    <ellipse cx="68" cy="57" rx="5" ry="3" fill="#f43f5e" opacity="0.6"/>
                    <!-- Mũi & Miệng cười -->
                    <path d="M47,54 Q50,52 53,54 Q50,57 47,54 Z" fill="#dc2626"/>
                    <path d="M44,58 Q50,64 56,58" stroke="#9a3412" stroke-width="2.2" stroke-linecap="round" fill="none"/>
                    <!-- Hai bàn chân bám sớ -->
                    <g class="lion-paws">
                        <ellipse cx="38" cy="74" rx="7" ry="5" fill="#fbbf24" stroke="#d97706" stroke-width="1.5"/>
                        <ellipse cx="62" cy="74" rx="7" ry="5" fill="#fbbf24" stroke="#d97706" stroke-width="1.5"/>
                    </g>
                </svg>
            </div>

            <!-- Tờ Sớ Ở Giữa -->
            <div class="scroll-ceremony" id="scrollCeremony" role="button" tabindex="0" title="Bé chạm vào tờ sớ để nhận lời chúc may mắn!">
                <div class="scroll-roller"></div>
                <div class="scroll-body">
                    <span class="sparkle-star star-1">✨</span>
                    <span class="sparkle-star star-2">⭐</span>
                    <span class="sparkle-star star-3">✨</span>
                    <span class="sparkle-star star-4">⭐</span>
                    <span class="scroll-sub-top">CHÀO MỪNG BÉ ĐẾN VỚI</span>
                    <h1 class="scroll-brand-title mb-0">ĐỒ RÊ MÍ 2</h1>
                    <span class="scroll-sub-bottom">ƯƠM MẦM TƯƠNG LAI • CHẮP CÁNH ƯỚC MƠ</span>
                </div>
                <div class="scroll-roller"></div>
            </div>

            <!-- Chú Lân Phải -->
            <div class="lion-mascot lion-right" id="lionMascotRight" role="button" tabindex="0" title="Bé chạm vào chú lân để nghe tiếng cổ vũ!">
                <svg class="lion-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <!-- Bờm sư tử / lân nhiều cánh -->
                    <g class="lion-mane">
                        <circle cx="50" cy="50" r="44" fill="#f59e0b"/>
                        <circle cx="20" cy="40" r="14" fill="#ea580c"/>
                        <circle cx="80" cy="40" r="14" fill="#ea580c"/>
                        <circle cx="18" cy="60" r="13" fill="#f97316"/>
                        <circle cx="82" cy="60" r="13" fill="#f97316"/>
                        <circle cx="30" cy="22" r="14" fill="#ea580c"/>
                        <circle cx="70" cy="22" r="14" fill="#ea580c"/>
                        <circle cx="50" cy="16" r="14" fill="#dc2626"/>
                    </g>
                    <!-- Tai sư tử -->
                    <path d="M22,32 Q14,16 32,24 Z" fill="#ef4444"/>
                    <path d="M25,29 Q19,20 30,25 Z" fill="#fecdd3"/>
                    <path d="M78,32 Q86,16 68,24 Z" fill="#ef4444"/>
                    <path d="M75,29 Q81,20 70,25 Z" fill="#fecdd3"/>
                    <!-- Khuôn mặt tròn chibi -->
                    <circle cx="50" cy="52" r="32" fill="#fffbeb" stroke="#f59e0b" stroke-width="2"/>
                    <!-- Sừng / Mũ lân trang trí -->
                    <path d="M50,20 Q56,32 50,38 Q44,32 50,20 Z" fill="#ef4444"/>
                    <circle cx="50" cy="22" r="4" fill="#fde047"/>
                    <!-- Mắt sư tử có hiệu ứng chớp -->
                    <g class="lion-eyes">
                        <ellipse class="lion-eye" cx="38" cy="48" rx="4.5" ry="5.5" fill="#1e293b"/>
                        <circle cx="39.5" cy="46.5" r="1.8" fill="#ffffff"/>
                        <ellipse class="lion-eye" cx="62" cy="48" rx="4.5" ry="5.5" fill="#1e293b"/>
                        <circle cx="63.5" cy="46.5" r="1.8" fill="#ffffff"/>
                    </g>
                    <!-- Má hồng đáng yêu -->
                    <ellipse cx="32" cy="57" rx="5" ry="3" fill="#f43f5e" opacity="0.6"/>
                    <ellipse cx="68" cy="57" rx="5" ry="3" fill="#f43f5e" opacity="0.6"/>
                    <!-- Mũi & Miệng cười -->
                    <path d="M47,54 Q50,52 53,54 Q50,57 47,54 Z" fill="#dc2626"/>
                    <path d="M44,58 Q50,64 56,58" stroke="#9a3412" stroke-width="2.2" stroke-linecap="round" fill="none"/>
                    <!-- Hai bàn chân bám sớ -->
                    <g class="lion-paws">
                        <ellipse cx="38" cy="74" rx="7" ry="5" fill="#fbbf24" stroke="#d97706" stroke-width="1.5"/>
                        <ellipse cx="62" cy="74" rx="7" ry="5" fill="#fbbf24" stroke="#d97706" stroke-width="1.5"/>
                    </g>
                </svg>
            </div>
        </div>
    </div>
    <% } %>

