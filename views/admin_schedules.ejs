<script>
    const currentScheduleId = <%= schedule ? schedule.id : 'null' %>;
    const currentClassId = <%= selectedClassId ? selectedClassId : 'null' %>;

    function openEditSlotModal(slotIndex, currentLabel) {
        document.getElementById('editSlotIndex').value = slotIndex;
        document.getElementById('editSlotLabelInput').value = currentLabel;
        const modal = new bootstrap.Modal(document.getElementById('editTimeSlotModal'));
        modal.show();
    }

    // Excel Selection State
    let isMouseDown = false;
    let startSlot = null;
    let startDay = null;
    let currentSlot = null;
    let currentDay = null;
    
    // Bounds of current rectangular selection
    let selectedBounds = null; // { minSlot, maxSlot, minDay, maxDay }
    let clipboardData = null; // for Copy/Paste

    let cellEditModal;

    document.addEventListener("DOMContentLoaded", () => {
        const modalEl = document.getElementById('cellEditModal');
        if (modalEl) cellEditModal = new bootstrap.Modal(modalEl);

        initExcelGridInteractions();
    });

    // ==========================================
    // EXCEL GRID SELECTION ENGINE
    // ==========================================
    function initExcelGridInteractions() {
        const table = document.getElementById('excelGridTable');
        if (!table) return;

        // Mousedown trên cell
        table.addEventListener('mousedown', (e) => {
            const cell = e.target.closest('.excel-cell');
            if (!cell) return;
            
            isMouseDown = true;
            const slot = parseInt(cell.dataset.slot);
            const day = parseInt(cell.dataset.day);

            if (e.shiftKey && startSlot !== null && startDay !== null) {
                // Shift+Click: mở rộng vùng chọn
                currentSlot = slot;
                currentDay = day;
                updateSelection();
            } else {
                startSlot = slot;
                startDay = day;
                currentSlot = slot;
                currentDay = day;
                updateSelection();
            }
        });

        // Mouseover trong khi đang drag
        table.addEventListener('mouseover', (e) => {
            if (!isMouseDown) return;
            const cell = e.target.closest('.excel-cell');
            if (!cell) return;

            const slot = parseInt(cell.dataset.slot);
            const day = parseInt(cell.dataset.day);
            if (slot !== currentSlot || day !== currentDay) {
                currentSlot = slot;
                currentDay = day;
                updateSelection();
            }
        });

        // Mouseup
        document.addEventListener('mouseup', () => {
            if (isMouseDown) {
                isMouseDown = false;
            }
        });

        // Drag & Drop từ thư viện hoạt động
        table.addEventListener('dragover', (e) => {
            e.preventDefault();
            const cell = e.target.closest('.excel-cell');
            if (cell) cell.classList.add('cell-drag-over');
        });

        table.addEventListener('dragleave', (e) => {
            const cell = e.target.closest('.excel-cell');
            if (cell) cell.classList.remove('cell-drag-over');
        });

        table.addEventListener('drop', (e) => {
            e.preventDefault();
            const cell = e.target.closest('.excel-cell');
            if (!cell) return;
            cell.classList.remove('cell-drag-over');

            const activityData = e.dataTransfer.getData('text/plain');
            if (activityData) {
                try {
                    const { title, color } = JSON.parse(activityData);
                    const slot = parseInt(cell.dataset.slot);
                    const day = parseInt(cell.dataset.day);
                    applyActivityToCell(slot, day, title, color);
                } catch (err) {}
            }
        });

        // Keyboard Shortcuts (Ctrl+C, Ctrl+V, Delete)
        document.addEventListener('keydown', (e) => {
            // Không can thiệp nếu đang nhập trong input/textarea
            if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'c') {
                e.preventDefault();
                handleCopyCells();
            } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'v') {
                e.preventDefault();
                handlePasteCells();
            } else if (e.key === 'Delete' || e.key === 'Backspace') {
                e.preventDefault();
                handleClearCells();
            }
        });
    }

    function updateSelection() {
        if (startSlot === null || startDay === null || currentSlot === null || currentDay === null) return;

        let minSlot = Math.min(startSlot, currentSlot);
        let maxSlot = Math.max(startSlot, currentSlot);
        let minDay = Math.min(startDay, currentDay);
        let maxDay = Math.max(startDay, currentDay);

        // Mở rộng vùng chọn nếu chứa bất kỳ ô đã gộp nào (rowspan/colspan)
        let expanded = true;
        while (expanded) {
            expanded = false;
            for (let s = minSlot; s <= maxSlot; s++) {
                for (let d = minDay; d <= maxDay; d++) {
                    const el = document.getElementById(`cell_${s}_${d}`);
                    if (el) {
                        const rSpan = parseInt(el.dataset.rowspan || el.getAttribute('rowspan') || 1);
                        const cSpan = parseInt(el.dataset.colspan || el.getAttribute('colspan') || 1);
                        if (rSpan > 1 && s + rSpan - 1 > maxSlot) {
                            maxSlot = s + rSpan - 1;
                            expanded = true;
                        }
                        if (cSpan > 1 && d + cSpan - 1 > maxDay) {
                            maxDay = d + cSpan - 1;
                            expanded = true;
                        }
                    }
                }
            }
        }

        selectedBounds = { minSlot, maxSlot, minDay, maxDay };

        // Xóa class highlight cũ
        document.querySelectorAll('.excel-cell').forEach(c => {
            c.classList.remove('cell-selected', 'cell-focus');
        });

        // Highlight các ô nằm trong bounding box
        for (let s = minSlot; s <= maxSlot; s++) {
            for (let d = minDay; d <= maxDay; d++) {
                const cell = document.getElementById(`cell_${s}_${d}`);
                if (cell) {
                    cell.classList.add('cell-selected');
                }
            }
        }

        const focusCell = document.getElementById(`cell_${startSlot}_${startDay}`);
        if (focusCell) focusCell.classList.add('cell-focus');
    }

    // ==========================================
    // MERGE & UNMERGE LOGIC
    // ==========================================
    async function handleMergeCells() {
        if (!selectedBounds) {
            alert('Vui lòng kéo chuột chọn ít nhất 2 ô để gộp!');
            return;
        }

        const { minSlot, maxSlot, minDay, maxDay } = selectedBounds;
        const totalCells = (maxSlot - minSlot + 1) * (maxDay - minDay + 1);
        if (totalCells <= 1) {
            alert('Vui lòng chọn từ 2 ô trở lên để gộp ô!');
            return;
        }

        // Kiểm tra xem các ô được chọn có dữ liệu không
        let contents = [];
        let firstContent = '';
        let firstColor = '#ffffff';

        for (let s = minSlot; s <= maxSlot; s++) {
            for (let d = minDay; d <= maxDay; d++) {
                const cell = document.getElementById(`cell_${s}_${d}`);
                if (cell) {
                    const text = cell.innerText.trim();
                    if (text) contents.push(text);
                    if (s === minSlot && d === minDay) {
                        firstContent = text;
                        firstColor = cell.dataset.color || '#ffffff';
                    }
                }
            }
        }

        // Nếu có nhiều ô có nội dung -> Hỏi xác nhận
        if (contents.length > 1) {
            const confirmed = confirm(
                'Các ô được chọn đang có nội dung. Bạn có chắc muốn gộp các ô này không?\n\n' +
                'Lưu ý: Nội dung của ô đầu tiên ("' + firstContent + '") sẽ được giữ lại.'
            );
            if (!confirmed) return;
        }

        try {
            const res = await fetch('/admin/schedules/merge-cells', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    schedule_id: currentScheduleId,
                    class_id: currentClassId,
                    min_slot: minSlot,
                    max_slot: maxSlot,
                    min_day: minDay,
                    max_day: maxDay,
                    master_content: firstContent,
                    master_color: firstColor
                })
            });

            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert('Lỗi gộp ô: ' + (data.message || 'Thất bại'));
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối khi gộp ô');
        }
    }

    async function handleUnmergeCells() {
        if (!selectedBounds) {
            alert('Vui lòng chọn ô đã gộp để hủy gộp!');
            return;
        }

        let { minSlot, maxSlot, minDay, maxDay } = selectedBounds;

        // Mở rộng vùng hủy gộp nếu ô có rowspan/colspan
        for (let s = minSlot; s <= maxSlot; s++) {
            for (let d = minDay; d <= maxDay; d++) {
                const el = document.getElementById(`cell_${s}_${d}`);
                if (el) {
                    const rSpan = parseInt(el.dataset.rowspan || el.getAttribute('rowspan') || 1);
                    const cSpan = parseInt(el.dataset.colspan || el.getAttribute('colspan') || 1);
                    if (rSpan > 1) maxSlot = Math.max(maxSlot, s + rSpan - 1);
                    if (cSpan > 1) maxDay = Math.max(maxDay, d + cSpan - 1);
                }
            }
        }

        try {
            const res = await fetch('/admin/schedules/unmerge-cells', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    schedule_id: currentScheduleId,
                    class_id: currentClassId,
                    min_slot: minSlot,
                    max_slot: maxSlot,
                    min_day: minDay,
                    max_day: maxDay
                })
            });

            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert('Lỗi hủy gộp ô: ' + (data.message || 'Thất bại'));
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối khi hủy gộp ô');
        }
    }

    // ==========================================
    // COPY / PASTE / CLEAR
    // ==========================================
    function handleCopyCells() {
        if (!selectedBounds) return;
        const { minSlot, maxSlot, minDay, maxDay } = selectedBounds;

        const cells = [];
        for (let s = minSlot; s <= maxSlot; s++) {
            for (let d = minDay; d <= maxDay; d++) {
                const cell = document.getElementById(`cell_${s}_${d}`);
                cells.push({
                    relSlot: s - minSlot,
                    relDay: d - minDay,
                    content: cell ? cell.innerText.trim() : '',
                    bg_color: cell ? cell.dataset.color || '#ffffff' : '#ffffff'
                });
            }
        }

        clipboardData = {
            width: maxDay - minDay + 1,
            height: maxSlot - minSlot + 1,
            cells
        };

        // Flash viền báo hiệu copy
        document.querySelectorAll('.cell-selected').forEach(c => {
            c.style.transition = 'all 0.1s';
            c.style.opacity = '0.5';
            setTimeout(() => c.style.opacity = '1', 150);
        });
    }

    async function handlePasteCells() {
        if (!clipboardData || !selectedBounds) return;

        const targetStartSlot = selectedBounds.minSlot;
        const targetStartDay = selectedBounds.minDay;

        const updateBatch = [];
        for (const item of clipboardData.cells) {
            const destSlot = targetStartSlot + item.relSlot;
            const destDay = targetStartDay + item.relDay;

            if (destSlot < 7 && destDay <= 7) {
                updateBatch.push({
                    slot_index: destSlot,
                    day_of_week: destDay,
                    content: item.content,
                    bg_color: item.bg_color
                });
            }
        }

        if (updateBatch.length === 0) return;

        await sendBatchCellUpdate(updateBatch);
    }

    async function handleClearCells() {
        if (!selectedBounds) return;
        const { minSlot, maxSlot, minDay, maxDay } = selectedBounds;

        const updateBatch = [];
        for (let s = minSlot; s <= maxSlot; s++) {
            for (let d = minDay; d <= maxDay; d++) {
                updateBatch.push({
                    slot_index: s,
                    day_of_week: d,
                    content: '',
                    bg_color: '#ffffff'
                });
            }
        }

        await sendBatchCellUpdate(updateBatch);
    }

    async function applyColorToSelection(color) {
        if (!selectedBounds) return;
        const { minSlot, maxSlot, minDay, maxDay } = selectedBounds;

        const updateBatch = [];
        for (let s = minSlot; s <= maxSlot; s++) {
            for (let d = minDay; d <= maxDay; d++) {
                const cell = document.getElementById(`cell_${s}_${d}`);
                updateBatch.push({
                    slot_index: s,
                    day_of_week: d,
                    content: cell ? cell.innerText.trim() : '',
                    bg_color: color
                });
            }
        }

        await sendBatchCellUpdate(updateBatch);
    }

    // ==========================================
    // THƯ VIỆN HOẠT ĐỘNG
    // ==========================================
    function handleActivityDragStart(e, title, color) {
        e.dataTransfer.setData('text/plain', JSON.stringify({ title, color }));
    }

    async function applyActivityToSelection(title, color) {
        if (!selectedBounds) {
            alert('Vui lòng chọn 1 hoặc nhiều ô trên bảng trước khi nhấp hoạt động!');
            return;
        }

        const { minSlot, maxSlot, minDay, maxDay } = selectedBounds;
        const updateBatch = [];

        for (let s = minSlot; s <= maxSlot; s++) {
            for (let d = minDay; d <= maxDay; d++) {
                updateBatch.push({
                    slot_index: s,
                    day_of_week: d,
                    content: title,
                    bg_color: color
                });
            }
        }

        await sendBatchCellUpdate(updateBatch);
    }

    async function applyActivityToCell(slot, day, title, color) {
        await sendBatchCellUpdate([{
            slot_index: slot,
            day_of_week: day,
            content: title,
            bg_color: color
        }]);
    }

    function selectNewActColor(colorHex, btn) {
        document.getElementById('newActivityColor').value = colorHex;
        btn.parentElement.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    async function saveNewActivity() {
        const title = document.getElementById('newActivityTitle').value.trim();
        const color = document.getElementById('newActivityColor').value;

        if (!title) {
            alert('Vui lòng nhập tên hoạt động!');
            return;
        }

        try {
            const res = await fetch('/admin/activities/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title, default_color: color })
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert('Lỗi khi lưu hoạt động');
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối');
        }
    }

    async function deleteActivity(id, event) {
        event.stopPropagation();
        if (!confirm('Bạn có muốn xóa hoạt động này khỏi thư viện?')) return;

        try {
            const res = await fetch(`/admin/activities/delete/${id}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    // ==========================================
    // MODAL CHỈNH SỬA TRỰC TIẾP
    // ==========================================
    function openEditModal(cell) {
        const slot = cell.dataset.slot;
        const day = cell.dataset.day;
        const content = cell.innerText.trim();
        const color = cell.dataset.color || '#ffffff';

        document.getElementById('modalCellSlot').value = slot;
        document.getElementById('modalCellDay').value = day;
        document.getElementById('modalCellContent').value = content;
        document.getElementById('modalCellColor').value = color;

        cellEditModal.show();
    }

    function setModalColor(color) {
        document.getElementById('modalCellColor').value = color;
    }

    async function saveModalEdit() {
        const slot = parseInt(document.getElementById('modalCellSlot').value);
        const day = parseInt(document.getElementById('modalCellDay').value);
        const content = document.getElementById('modalCellContent').value.trim();
        const color = document.getElementById('modalCellColor').value;

        await sendBatchCellUpdate([{
            slot_index: slot,
            day_of_week: day,
            content,
            bg_color: color
        }]);

        cellEditModal.hide();
    }

    // Helper thêm hoạt động mới vào UI Thư viện hoạt động mà không cần tải lại trang
    function appendActivityToUI(act) {
        if (!act || !act.id) return;
        const list = document.getElementById('activityList');
        if (!list) return;
        if (document.getElementById(`act_item_${act.id}`)) return;

        const div = document.createElement('div');
        div.id = `act_item_${act.id}`;
        div.className = 'activity-item bg-white p-2 rounded-3 d-flex align-items-center justify-content-between shadow-sm';
        div.draggable = true;
        div.setAttribute('ondragstart', `handleActivityDragStart(event, "${act.title.replace(/"/g, '&quot;')}", "${act.default_color}")`);
        div.setAttribute('onclick', `applyActivityToSelection("${act.title.replace(/"/g, '&quot;')}", "${act.default_color}")`);

        div.innerHTML = `
            <div class="d-flex align-items-center gap-2 text-start">
                <span class="color-dot flex-shrink-0" style="background-color: ${act.default_color};"></span>
                <span class="small fw-semibold text-dark">${act.title}</span>
            </div>
            <button class="btn btn-sm btn-link text-danger p-0 ms-1" onclick="deleteActivity(${act.id}, event)" title="Xóa hoạt động">
                <i class="bi bi-x"></i>
            </button>
        `;
        list.appendChild(div);
    }

    // Helper gửi AJAX cập nhật mảng cells
    async function sendBatchCellUpdate(cells) {
        try {
            const res = await fetch('/admin/schedules/batch-update-cells', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    schedule_id: currentScheduleId,
                    class_id: currentClassId,
                    cells
                })
            });
            const data = await res.json();
            if (data.success) {
                // Cập nhật DOM trực tiếp để mượt mà
                for (const item of cells) {
                    const el = document.getElementById(`cell_${item.slot_index}_${item.day_of_week}`);
                    if (el) {
                        el.innerText = item.content;
                        el.dataset.color = item.bg_color;
                        el.style.backgroundColor = item.bg_color;
                        el.style.color = (!item.bg_color || item.bg_color === '#ffffff') ? 'inherit' : '#000';
                    }
                }

                // Tự động thêm các hoạt động mới vừa nhập vào sidebar Thư viện hoạt động
                if (data.newActivities && Array.isArray(data.newActivities)) {
                    data.newActivities.forEach(act => appendActivityToUI(act));
                } else if (data.newActivity) {
                    appendActivityToUI(data.newActivity);
                }
            } else {
                alert('Lỗi cập nhật ô: ' + (data.message || 'Thất bại'));
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối');
        }
    }
</script>

