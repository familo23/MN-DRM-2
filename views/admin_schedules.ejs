<%- include('layouts/header', { title: 'Quản lý Lịch Học - Admin' }) %>

<style>
    /* EXCEL-LIKE GRID & STYLING */
    .excel-table {
        user-select: none;
        border-collapse: separate;
        border-spacing: 0;
    }
    .excel-cell {
        min-height: 70px;
        height: 70px;
        position: relative;
        cursor: cell;
        transition: background-color 0.1s;
        border: 1px solid #dee2e6 !important;
        font-size: 0.95rem;
    }
    .excel-cell:hover {
        outline: 2px solid #5b9bd5;
        outline-offset: -2px;
        z-index: 5;
    }
    .excel-cell.cell-selected {
        outline: 2px solid #1976d2 !important;
        background-color: rgba(25, 118, 210, 0.15) !important;
        outline-offset: -2px;
        z-index: 10;
    }
    .excel-cell.cell-focus {
        outline: 3px solid #0d6efd !important;
        outline-offset: -3px;
        z-index: 15;
    }
    .color-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        display: inline-block;
        border: 1px solid rgba(0,0,0,0.15);
    }
    .color-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid #ccc;
        cursor: pointer;
        transition: transform 0.15s;
    }
    .color-btn:hover {
        transform: scale(1.15);
        border-color: #333;
    }
    .color-btn.active {
        border-color: #000;
        box-shadow: 0 0 8px rgba(0,0,0,0.3);
    }
    .activity-item {
        cursor: grab;
        transition: all 0.2s ease;
        border: 1px solid #e0e0e0;
    }
    .activity-item:hover {
        transform: translateX(4px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        border-color: var(--bs-primary);
    }
    .activity-item:active {
        cursor: grabbing;
    }
    .toolbar-btn {
        font-size: 0.88rem;
        font-weight: 600;
        padding: 0.4rem 0.8rem;
    }
    .cell-drag-over {
        outline: 3px dashed #198754 !important;
        background-color: rgba(25, 135, 84, 0.2) !important;
    }
</style>

<main class="container-fluid py-4 px-lg-4">
    <div class="row g-4">
        <!-- Sidebar -->
        <div class="col-lg-2 col-md-3">
            <%- include('partials/sidebar') %>
        </div>

        <!-- Main Content (Grid + Activity Library) -->
        <div class="col-lg-10 col-md-9">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    
                    <!-- HEADER & BỘ LỌC LỚP + TUẦN -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-3 border-bottom">
                        <div>
                            <h2 class="fw-bold text-primary mb-1">
                                <i class="bi bi-grid-3x3 me-2"></i>Quản Lý Thời Khóa Biểu
                            </h2>
                            <p class="text-muted small mb-0">Công cụ soạn thảo TKB tương tác chuẩn Excel cho Giáo viên</p>
                        </div>
                        
                        <!-- CÁC NÚT TẠO TUẦN -->
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-primary rounded-pill fw-bold toolbar-btn" data-bs-toggle="modal" data-bs-target="#createWeekModal">
                                <i class="bi bi-plus-lg me-1"></i>+ Tạo 1 Tuần Mới
                            </button>
                            <button class="btn btn-primary rounded-pill fw-bold toolbar-btn shadow-sm" data-bs-toggle="modal" data-bs-target="#createBatchModal">
                                <i class="bi bi-collection-play me-1"></i>+ Tạo Hàng Loạt Tuần
                            </button>
                        </div>
                    </div>

                    <!-- THANH CHỌN LỚP VÀ TUẦN LÀM VIỆC -->
                    <div class="bg-light rounded-4 p-3 mb-4">
                        <form action="/admin/schedules" method="GET" class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted mb-1">Lớp Học:</label>
                                <select class="form-select fw-bold border-primary shadow-sm" name="class_id" onchange="this.form.submit()">
                                    <% if (classes && classes.length > 0) { %>
                                        <% classes.forEach(function(cls) { %>
                                            <option value="<%= cls.id %>" <%= selectedClassId === cls.id ? 'selected' : '' %>>
                                                Lớp: <%= cls.name %>
                                            </option>
                                        <% }); %>
                                    <% } else { %>
                                        <option value="">Chưa có lớp học</option>
                                    <% } %>
                                </select>
                            </div>

                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-muted mb-1">Chọn Tuần Làm Việc:</label>
                                <select class="form-select fw-semibold border-secondary-subtle shadow-sm" name="schedule_id" onchange="this.form.submit()" <%= !allSchedules || allSchedules.length === 0 ? 'disabled' : '' %>>
                                    <% if (allSchedules && allSchedules.length > 0) { %>
                                        <% allSchedules.forEach(function(s) { %>
                                            <option value="<%= s.id %>" <%= schedule && schedule.id === s.id ? 'selected' : '' %>>
                                                <%= s.week_label %> (<%= s.date_range %>) - <%= s.month_title %>
                                            </option>
                                        <% }); %>
                                    <% } else { %>
                                        <option value="">Chưa có tuần nào. Hãy tạo mới!</option>
                                    <% } %>
                                </select>
                            </div>

                            <div class="col-md-3 d-flex align-items-end">
                                <% if (schedule) { %>
                                    <div class="dropdown w-100">
                                        <button class="btn btn-outline-secondary dropdown-toggle w-100 fw-bold shadow-sm" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-gear me-1"></i>Thao tác Tuần
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                            <li>
                                                <button class="dropdown-item py-2 fw-semibold" type="button" data-bs-toggle="modal" data-bs-target="#copyWeekModal">
                                                    <i class="bi bi-copy me-2 text-primary"></i>Sao chép từ tuần khác
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item py-2 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#scheduleInfoCollapse">
                                                    <i class="bi bi-pencil-square me-2 text-success"></i>Sửa Tiêu đề & Thời gian
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger py-2 fw-semibold" onclick="submitDeleteWeekForm()">
                                                    <i class="bi bi-trash3 me-2"></i>Xóa Tuần này (Soft Delete)
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                <% } %>
                            </div>
                        </form>

                        <% if (schedule) { %>
                            <!-- Form độc lập xử lý Soft Delete để tránh lồng thẻ form trong HTML -->
                            <form id="deleteWeekForm" action="/admin/schedules/delete-week" method="POST" style="display:none;">
                                <input type="hidden" name="schedule_id" value="<%= schedule.id %>">
                                <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                            </form>
                            <script>
                                function submitDeleteWeekForm() {
                                    if (confirm('Bạn có chắc chắn muốn XÓA MỀM tuần này không? Lịch học sẽ được ẩn khỏi phụ huynh và lưu trữ an toàn.')) {
                                        document.getElementById('deleteWeekForm').submit();
                                    }
                                }
                            </script>
                        <% } %>
                    </div>

                    <% if (schedule) { %>
                        <!-- COLLAPSE FORM SỬA TIÊU ĐỀ TUẦN -->
                        <div class="collapse mb-4" id="scheduleInfoCollapse">
                            <div class="card border border-primary-subtle rounded-4 shadow-sm">
                                <div class="card-header bg-primary-subtle fw-bold text-primary py-2">
                                    <i class="bi bi-sliders me-2"></i>Cài đặt Tiêu đề & Thời gian áp dụng
                                </div>
                                <div class="card-body p-4">
                                    <form action="/admin/schedules/update-info" method="POST" class="row g-3">
                                        <input type="hidden" name="schedule_id" value="<%= schedule.id %>">
                                        <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                                        
                                        <div class="col-md-2">
                                            <label class="form-label small fw-bold">Số Thứ Tự Tuần</label>
                                            <input type="number" name="week_number" class="form-control" value="<%= schedule.week_number || 1 %>">
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-bold">Nhãn Tuần</label>
                                            <input type="text" name="week_label" class="form-control" value="<%= schedule.week_label %>" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold">Tháng</label>
                                            <input type="text" name="month_title" class="form-control" value="<%= schedule.month_title %>" required>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label small fw-bold">Chủ đề tuần</label>
                                            <input type="text" name="theme_title" class="form-control" value="<%= schedule.theme_title %>">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold">Ngày bắt đầu (T2)</label>
                                            <input type="date" name="week_start" class="form-control" value="<%= schedule.week_start ? new Date(schedule.week_start).toISOString().split('T')[0] : '' %>">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold">Ngày kết thúc (T7)</label>
                                            <input type="date" name="week_end" class="form-control" value="<%= schedule.week_end ? new Date(schedule.week_end).toISOString().split('T')[0] : '' %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold">Hiển thị khoảng ngày (Chuỗi)</label>
                                            <input type="text" name="date_range" class="form-control" value="<%= schedule.date_range %>">
                                        </div>
                                        <div class="col-md-2 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary w-100 fw-bold">Lưu Cài Đặt</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- EXCEL TOOLBAR & ACTIVITY LIBRARY GRID -->
                        <div class="row g-3">
                            <!-- CỘT BẢNG TKB (EXCEL GRID) -->
                            <div class="col-xl-9 col-lg-8">
                                
                                <!-- EXCEL ACTION TOOLBAR -->
                                <div class="card border border-secondary-subtle rounded-4 shadow-sm mb-3 bg-light">
                                    <div class="card-body p-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                                        <!-- Nhóm thao tác Ô -->
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-success toolbar-btn rounded-3" data-bs-toggle="modal" data-bs-target="#addTimeSlotModal" title="Thêm khung giờ mới (Thêm hàng)">
                                                <i class="bi bi-plus-circle me-1"></i>+ Thêm Khung Giờ (Hàng)
                                            </button>
                                            
                                            <div class="vr mx-1"></div>

                                            <button type="button" class="btn btn-sm btn-outline-primary toolbar-btn rounded-3" id="btnMerge" onclick="handleMergeCells()" title="Gộp các ô được chọn">
                                                <i class="bi bi-bounding-box-circles me-1"></i>Gộp Ô (Merge)
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary toolbar-btn rounded-3" id="btnUnmerge" onclick="handleUnmergeCells()" title="Hủy gộp ô">
                                                <i class="bi bi-grid-1x2 me-1"></i>Hủy Gộp (Unmerge)
                                            </button>
                                            
                                            <div class="vr mx-1"></div>

                                            <button type="button" class="btn btn-sm btn-outline-dark toolbar-btn rounded-3" id="btnCopy" onclick="handleCopyCells()" title="Sao chép ô (Ctrl+C)">
                                                <i class="bi bi-clipboard me-1"></i>Copy
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-dark toolbar-btn rounded-3" id="btnPaste" onclick="handlePasteCells()" title="Dán vào ô (Ctrl+V)">
                                                <i class="bi bi-clipboard-check me-1"></i>Paste
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger toolbar-btn rounded-3" onclick="handleClearCells()" title="Xóa nội dung ô">
                                                <i class="bi bi-eraser me-1"></i>Xóa Ô
                                            </button>
                                        </div>

                                        <!-- Bảng màu nhanh -->
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="small fw-bold text-muted me-1">Màu ô:</span>
                                            <button type="button" class="color-btn" style="background-color: #ffffff" onclick="applyColorToSelection('#ffffff')" title="Trắng"></button>
                                            <button type="button" class="color-btn" style="background-color: #92d050" onclick="applyColorToSelection('#92d050')" title="Xanh lá"></button>
                                            <button type="button" class="color-btn" style="background-color: #ffc000" onclick="applyColorToSelection('#ffc000')" title="Vàng"></button>
                                            <button type="button" class="color-btn" style="background-color: #00b0f0" onclick="applyColorToSelection('#00b0f0')" title="Xanh dương"></button>
                                            <button type="button" class="color-btn" style="background-color: #ff99cc" onclick="applyColorToSelection('#ff99cc')" title="Hồng"></button>
                                            <button type="button" class="color-btn" style="background-color: #ffc7ce" onclick="applyColorToSelection('#ffc7ce')" title="Đỏ nhạt"></button>
                                        </div>
                                    </div>
                                </div>

                                <!-- LƯỚI THỜI KHÓA BIỂU (EXCEL GRID) -->
                                <div class="table-responsive shadow-sm rounded-4 border border-secondary-subtle bg-white">
                                    <table class="table table-bordered text-center align-middle mb-0 excel-table" id="excelGridTable">
                                        <thead class="bg-primary text-white">
                                            <tr>
                                                <th class="py-3" style="width: 16%">Thời gian</th>
                                                <th class="py-3" style="width: 14%">Thứ 2</th>
                                                <th class="py-3" style="width: 14%">Thứ 3</th>
                                                <th class="py-3" style="width: 14%">Thứ 4</th>
                                                <th class="py-3" style="width: 14%">Thứ 5</th>
                                                <th class="py-3" style="width: 14%">Thứ 6</th>
                                                <th class="py-3" style="width: 14%">Thứ 7</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% for(let s=0; s < timeSlots.length; s++) { %>
                                                <tr>
                                                    <td class="text-primary fw-bold bg-light position-relative p-2" style="user-select:none; font-size: 0.88rem;">
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <span class="text-truncate" title="<%= timeSlots[s] %>"><%= timeSlots[s] %></span>
                                                            <div class="d-inline-flex gap-1 ms-1">
                                                                <button type="button" class="btn btn-sm btn-link p-0 text-secondary" onclick="openEditSlotModal(<%= s %>, '<%= timeSlots[s].replace(/'/g, "\\'") %>')" title="Sửa tên khung giờ">
                                                                    <i class="bi bi-pencil-square"></i>
                                                                </button>
                                                                <% if (timeSlots.length > 1) { %>
                                                                    <form action="/admin/schedules/delete-time-slot" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa hàng khung giờ [<%= timeSlots[s] %>] không? Toàn bộ các ô trong hàng này sẽ bị xóa.');">
                                                                        <input type="hidden" name="schedule_id" value="<%= schedule.id %>">
                                                                        <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                                                                        <input type="hidden" name="slot_index" value="<%= s %>">
                                                                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger" title="Xóa hàng này">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </form>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <% for(let d=2; d <= 7; d++) { %>
                                                        <% const cell = (matrix[s] && matrix[s][d-2]) ? matrix[s][d-2] : null; %>
                                                        <% if (cell && cell.is_merged == 0) { %>
                                                            <% const inlineStyle = `background-color: ${cell.bg_color || '#ffffff'}; color: ${(!cell.bg_color || cell.bg_color === '#ffffff') ? 'inherit' : '#000'}`; %>
                                                            <td class="excel-cell fw-semibold" 
                                                                id="cell_<%= s %>_<%= d %>"
                                                                data-cell-id="<%= cell.id %>"
                                                                data-slot="<%= s %>" 
                                                                data-day="<%= d %>"
                                                                data-rowspan="<%= cell.row_span || 1 %>"
                                                                data-colspan="<%= cell.col_span || 1 %>"
                                                                data-color="<%= cell.bg_color || '#ffffff' %>"
                                                                rowspan="<%= cell.row_span || 1 %>" 
                                                                colspan="<%= cell.col_span || 1 %>"
                                                                style="<%= inlineStyle %>"
                                                                ondblclick="openEditModal(this)">
                                                                <%= cell.content %>
                                                            </td>
                                                        <% } else if (!cell) { %>
                                                            <td class="excel-cell fw-semibold" id="cell_<%= s %>_<%= d %>" data-slot="<%= s %>" data-day="<%= d %>" data-rowspan="1" data-colspan="1" data-color="#ffffff" ondblclick="openEditModal(this)"></td>
                                                        <% } %>
                                                    <% } %>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                    
                                    <!-- Nút thêm nhanh khung giờ ở chân bảng -->
                                    <div class="text-center p-2 bg-light border-top">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#addTimeSlotModal">
                                            <i class="bi bi-plus-lg me-1"></i>+ Thêm Khung Giờ Mới (Thêm Hàng)
                                        </button>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 text-muted small">
                                    <div>
                                        <i class="bi bi-info-circle me-1"></i>
                                        <span><b>Hướng dẫn:</b> Kéo chuột chọn nhiều ô để <b>Gộp Ô</b>, nhấn <b>Ctrl+C / Ctrl+V</b> để sao chép, hoặc kéo thả hoạt động từ thư viện bên phải vào ô. Nháy đúp vào ô để sửa văn bản.</span>
                                    </div>
                                </div>

                            </div>

                            <!-- CỘT THƯ VIỆN HOẠT ĐỘNG (ACTIVITY LIBRARY) -->
                            <div class="col-xl-3 col-lg-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100 bg-light">
                                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center rounded-top-4">
                                        <h6 class="fw-bold text-primary mb-0">
                                            <i class="bi bi-bookmark-star-fill text-warning me-1"></i>Thư Viện Hoạt Động
                                        </h6>
                                        <button class="btn btn-sm btn-primary rounded-pill px-2 py-1 small fw-bold" data-bs-toggle="modal" data-bs-target="#createActivityModal">
                                            <i class="bi bi-plus"></i>Thêm
                                        </button>
                                    </div>
                                    <div class="card-body p-3 overflow-auto" style="max-height: 580px;">
                                        <p class="small text-muted mb-2">Nhấp hoặc kéo thả vào ô TKB:</p>
                                        <div class="d-flex flex-column gap-2" id="activityList">
                                            <% if (activities && activities.length > 0) { %>
                                                <% activities.forEach(function(act) { %>
                                                    <div class="activity-item bg-white p-2 rounded-3 d-flex align-items-center justify-content-between"
                                                         draggable="true"
                                                         ondragstart="handleActivityDragStart(event, '<%= act.title %>', '<%= act.default_color %>')"
                                                         onclick="applyActivityToSelection('<%= act.title %>', '<%= act.default_color %>')">
                                                        <div class="d-flex align-items-center gap-2 text-start">
                                                            <span class="color-dot flex-shrink-0" style="background-color: <%= act.default_color %>;"></span>
                                                            <span class="small fw-semibold text-dark"><%= act.title %></span>
                                                        </div>
                                                        <% if (act.id > 12) { %>
                                                            <button class="btn btn-sm btn-link text-danger p-0 ms-1" onclick="deleteActivity(<%= act.id %>, event)" title="Xóa hoạt động">
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        <% } %>
                                                    </div>
                                                <% }); %>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    <% } else { %>
                        <!-- CHƯA CÓ TUẦN NÀO -->
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x display-1 text-muted mb-4 d-block opacity-50"></i>
                            <h3 class="fw-bold">Lớp này chưa có Thời Khóa Biểu</h3>
                            <p class="text-muted mb-4">Hãy tạo một tuần mới hoặc tạo hàng loạt tuần để bắt đầu soạn lịch học.</p>
                            <div class="d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-primary btn-lg rounded-pill fw-bold px-4" data-bs-toggle="modal" data-bs-target="#createWeekModal">
                                    <i class="bi bi-plus-lg me-2"></i>Tạo 1 Tuần Mới
                                </button>
                                <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createBatchModal">
                                    <i class="bi bi-collection-play me-2"></i>Tạo Hàng Loạt Tuần
                                </button>
                            </div>
                        </div>
                    <% } %>

                </div>
            </div>
        </div>
    </div>
</main>

<!-- MODAL TẠO 1 TUẦN MỚI -->
<div class="modal fade" id="createWeekModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form action="/admin/schedules/create-week" method="POST">
                <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-primary"><i class="bi bi-calendar-plus me-2"></i>Tạo Tuần Học Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngày bắt đầu tuần (Thứ 2):</label>
                        <input type="date" name="week_start" class="form-control" required value="<%= new Date().toISOString().split('T')[0] %>">
