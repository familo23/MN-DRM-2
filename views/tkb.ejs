<%- include('layouts/header', { title: 'Lịch Học - Mầm Non Đồ Rê Mí' }) %>

<main class="container py-5 my-4">
    
    <!-- THỜI KHÓA BIỂU MOCKUP -->
    <section id="lich" class="mb-5">
        <div class="text-center mb-5">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill mb-2 fs-6">Kế hoạch mỗi ngày</span>
            <h2 class="display-5 fw-bold text-primary mb-3">
                <i class="bi bi-calendar-heart text-danger me-2"></i>Thời Khóa Biểu
            </h2>
            <p class="text-muted fs-5">Lịch hoạt động một ngày vui vẻ của các bé</p>
        </div>

        <div class="table-responsive shadow rounded-4 overflow-hidden border border-primary-subtle bg-white">
            <table class="table table-bordered text-center align-middle mb-0 schedule-table">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="py-3" style="width: 15%">Thời gian</th>
                        <th class="py-3" style="width: 17%">Thứ 2</th>
                        <th class="py-3" style="width: 17%">Thứ 3</th>
                        <th class="py-3" style="width: 17%">Thứ 4</th>
                        <th class="py-3" style="width: 17%">Thứ 5</th>
                        <th class="py-3" style="width: 17%">Thứ 6</th>
                    </tr>
                </thead>
                <tbody class="fw-semibold text-secondary">
                    <tr>
                        <td class="text-primary fw-bold">08:20 - 08:45</td>
                        <td colspan="5" class="bg-light text-dark">Đón trẻ, Tập thể dục buổi sáng, Ăn sáng</td>
                    </tr>
                    <tr>
                        <td class="text-primary fw-bold">08:50 - 09:00</td>
                        <td colspan="5" class="bg-light text-dark">Uống sữa Vinamilk</td>
                    </tr>
                    <tr>
                        <td class="text-primary fw-bold">09:00 - 09:50</td>
                        <td class="bg-success-subtle text-success-emphasis">STEAM: Trống cơm</td>
                        <td class="bg-warning-subtle text-warning-emphasis">Toán: Hình tròn, Vuông</td>
                        <td class="bg-info-subtle text-info-emphasis">Âm nhạc: Yêu Hà Nội</td>
                        <td class="bg-danger-subtle text-danger-emphasis">Tạo hình: Đất nặn</td>
                        <td class="bg-primary-subtle text-primary-emphasis">Kỹ năng sống</td>
                    </tr>
                    <tr>
                        <td class="text-primary fw-bold">09:50 - 10:25</td>
                        <td class="bg-success-subtle text-success-emphasis">Tạo hình: Tô màu</td>
                        <td class="bg-warning-subtle text-warning-emphasis">LQ Toán: To - Nhỏ</td>
                        <td class="bg-info-subtle text-info-emphasis">HĐ Nhận biết Thủ Đô</td>
                        <td class="bg-danger-subtle text-danger-emphasis">Truyện: Kiến con</td>
                        <td class="bg-primary-subtle text-primary-emphasis">Giao lưu tập thể</td>
                    </tr>
                    <tr>
                        <td class="text-primary fw-bold">15:15 - 15:45</td>
                        <td colspan="5" class="bg-light text-dark">Hoạt động chiều & Ăn nhẹ</td>
                    </tr>
                    <tr>
                        <td class="text-primary fw-bold">16:00 - 18:00</td>
                        <td colspan="5" class="text-muted fst-italic">Phụ huynh đón trẻ ra về</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

</main>

<%- include('layouts/footer') %>
